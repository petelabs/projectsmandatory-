rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'alwaysgoodone265@gmail.com' ||
        request.auth.token.email == 'petedianolabs@gmail.com'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // Subscription Plans (Free, Premium, Premium Plus)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Payment Logs
    match /payments/{paymentId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.customerEmail == request.auth.token.email)) || isAdmin();
      allow write: if isAdmin();
    }

    // Streaming Activity & Qualifying Streams
    match /streams/{streamId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Creator Royalty Periods
    match /royaltyPeriods/{periodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Monthly Royalty Statements (Immutable once finalized)
    match /royaltyStatements/{statementId} {
      allow read: if (isAuthenticated() && resource.data.artistId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Artist Live & Finalized Earnings
    match /artistEarnings/{artistId} {
      allow read: if (isAuthenticated() && resource.data.artistId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Fan-to-Artist Tips
    match /tips/{tipId} {
      allow read: if (isAuthenticated() && (resource.data.artistId == request.auth.uid || resource.data.senderEmail == request.auth.token.email)) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Individual Song & Album Purchases
    match /purchases/{purchaseId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.customerEmail == request.auth.token.email)) || isAdmin();
      allow write: if isAdmin();
    }

    // Artist Payouts
    match /payouts/{payoutId} {
      allow read: if (isAuthenticated() && resource.data.artistId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Anti-Fraud Flags
    match /fraudFlags/{flagId} {
      allow read, write: if isAdmin();
    }

    // Platform Retained Revenue
    match /platformRevenue/{recordId} {
      allow read, write: if isAdmin();
    }

    // Admin Settings (Pool split %, stream qualification rules, ad config)
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Artists Profile Collection
    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // Artist Song Submissions
    match /artistSubmissions/{submissionId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.artistId == request.auth.uid);
    }

    // Songs Catalog
    match /songs/{songId} {
      allow read: if true;
      allow create, update: if isAdmin() || isAuthenticated();
      allow delete: if isAdmin();
    }

    // Boost & Share Referrals
    match /boostReferrals/{referralId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Orders Ledger
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.customerEmail == request.auth.token.email) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Music Promotion Requests
    match /promotionRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Website Contact Messages
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Server-only Collections
    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /downloadTokens/{tokenId} {
      allow read, write: if false;
    }

    match /artistSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
