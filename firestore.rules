rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'alwaysgoodone265@gmail.com' ||
        request.auth.token.email == 'petedianolabs@gmail.com'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // Artists Profile Collection
    match /artists/{artistId} {
      allow read: if true; // Public profiles are viewable by fans
      allow create, update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // Artist Song Submissions
    match /artistSubmissions/{submissionId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.artistId == request.auth.uid);
    }

    // Artist Fan Tips & Support
    match /artistTips/{tipId} {
      allow read: if true;
      allow create: if true; // Any fan can send a tip
      allow update, delete: if isAdmin();
    }

    // Artist Payouts
    match /artistPayouts/{payoutId} {
      allow read: if (isAuthenticated() && resource.data.artistId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Songs Catalog - publicly readable
    match /songs/{songId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders Ledger
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.customerEmail == request.auth.token.email) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Music Promotion Requests
    match /promotionRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Website Contact Messages
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Payment Events & Webhook Ledger (Server-only)
    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    // Download Tokens (Server-only)
    match /downloadTokens/{tokenId} {
      allow read, write: if false;
    }

    // Artist Settings
    match /artistSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
