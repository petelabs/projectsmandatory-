{
  "entities": {
    "User": {
      "title": "User",
      "description": "User and artist profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin", "artist"] },
        "isArtist": { "type": "boolean" },
        "artistId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Artist": {
      "title": "Artist",
      "description": "Registered artist profile, payout credentials, and wallet balances",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "artistName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "payoutDetails": { "type": "object" },
        "wallet": { "type": "object" },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["ACTIVE", "PENDING_APPROVAL", "SUSPENDED"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "artistName", "email", "phone"]
    },
    "ArtistSubmission": {
      "title": "ArtistSubmission",
      "description": "Artist song upload request with custom price up to K5000 and 70/30 platform split",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artistId": { "type": "string" },
        "artistName": { "type": "string" },
        "title": { "type": "string" },
        "priceMWK": { "type": "number" },
        "artistShareMWK": { "type": "number" },
        "platformShareMWK": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "audioFilePath": { "type": "string" },
        "coverImage": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "artistId", "title", "priceMWK", "status"]
    },
    "ArtistTip": {
      "title": "ArtistTip",
      "description": "Direct fan backing and supporter tips for artists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artistId": { "type": "string" },
        "artistName": { "type": "string" },
        "supporterName": { "type": "string" },
        "amountMWK": { "type": "number" },
        "artistShareMWK": { "type": "number" },
        "platformShareMWK": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "PAID", "FAILED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "artistId", "amountMWK", "status"]
    },
    "ArtistPayout": {
      "title": "ArtistPayout",
      "description": "Disbursement records for artist earnings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artistId": { "type": "string" },
        "amountMWK": { "type": "number" },
        "accountNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["REQUESTED", "PROCESSED", "REJECTED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "artistId", "amountMWK", "status"]
    },
    "Song": {
      "title": "Song",
      "description": "Published single-artist master track metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "artistId": { "type": "string" },
        "priceMWK": { "type": "number" },
        "artistShareMWK": { "type": "number" },
        "platformShareMWK": { "type": "number" },
        "coverImage": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "priceMWK", "isPublished"]
    },
    "Order": {
      "title": "Order",
      "description": "Music purchase order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "txRef": { "type": "string" },
        "songId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "txRef", "songId", "amount", "status"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "User messages submitted via the website contact form",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phoneOrWhatsApp": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phoneOrWhatsApp", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/artists/{artistId}": {
      "schema": { "$ref": "#/entities/Artist" },
      "description": "Registered artist profiles and payout setups"
    },
    "/artistSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ArtistSubmission" },
      "description": "Artist song upload requests for admin review"
    },
    "/artistTips/{tipId}": {
      "schema": { "$ref": "#/entities/ArtistTip" },
      "description": "Direct fan tips and support"
    },
    "/artistPayouts/{payoutId}": {
      "schema": { "$ref": "#/entities/ArtistPayout" },
      "description": "Artist payout records"
    },
    "/songs/{songId}": {
      "schema": { "$ref": "#/entities/Song" },
      "description": "Published song catalog"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Purchases and order ledger"
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "User contact messages"
    }
  }
}
